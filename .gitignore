# Ignore the bin directory
/bin/

# Ignore VS Code settings
.vscode/

# Ignore coverage files
cover.*
coverage.*

# Build artefacts live in /bin/ and /release/ (otfabric/engineering REPO-005)
/release/
*.test
coverage.out

# Output of a bare `go build`, anchored so it can never hide a source folder
/examples/client/client
/examples/commands/commands
/examples/events/events
/examples/files/files
/examples/observability/observability
/examples/quickstart/quickstart
/examples/redundancy/redundancy
/examples/secure/secure
/examples/server/server
/examples/tls/tls
